#!/bin/sh
# Bounded local feedback. CI (the Tests workflow, required check ci-ok) is the full gate.
# Bypass: SKIP_PREPUSH=1 git push. Branch deletions need no local run.

if [ "$SKIP_PREPUSH" = "1" ]; then
  echo "[pre-push] SKIP_PREPUSH=1 — skipping local feedback. CI will gate."
  exit 0
fi

empty_sha="0000000000000000000000000000000000000000"
has_push=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$empty_sha" ] && continue
  has_push=1
done
if [ "$has_push" = "0" ]; then
  echo "[pre-push] Delete-only push — skipping feedback."
  exit 0
fi

# An Intel (x86_64) git on an Apple-silicon Mac runs this hook under Rosetta, and
# every universal binary it launches (Playwright's Chromium) starts as x64 too: the
# browser journey then hangs past the lane deadline. Re-enter native arm64.
run_feedback() {
  if [ "$(uname -s)" = "Darwin" ] && [ "$(sysctl -in sysctl.proc_translated 2>/dev/null)" = "1" ]; then
    arch -arm64 /bin/sh -c 'npm run test:feedback'
  else
    npm run test:feedback
  fi
}

echo "[pre-push] Running bounded critical feedback lane…"
if ! run_feedback; then
  echo "[pre-push] ❌ test:feedback failed. Push aborted."
  echo "[pre-push]    Fix the failures, or rerun with SKIP_PREPUSH=1 git push if intentional."
  exit 1
fi
echo "[pre-push] ✅ feedback passed. The full test roster runs in CI."
