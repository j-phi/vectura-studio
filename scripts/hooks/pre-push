#!/bin/sh
# Bounded local feedback; CI retains the complete PR roster and routes it for evidence.
# Bypass: SKIP_PREPUSH=1 git push. Branch deletions need no local run.

if [ "$SKIP_PREPUSH" = "1" ]; then
  echo "[pre-push] SKIP_PREPUSH=1 — skipping local feedback. CI will gate."
  exit 0
fi

empty_sha="0000000000000000000000000000000000000000"
has_push=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$empty_sha" ] && continue
  has_push=1
done
if [ "$has_push" = "0" ]; then
  echo "[pre-push] Delete-only push — skipping feedback."
  exit 0
fi

echo "[pre-push] Running bounded critical feedback lane…"
if ! npm run test:feedback; then
  echo "[pre-push] ❌ test:feedback failed. Push aborted."
  echo "[pre-push]    Fix the failures, or rerun with SKIP_PREPUSH=1 git push if intentional."
  exit 1
fi
echo "[pre-push] ✅ feedback passed. Full risk routing and test roster run in CI."
